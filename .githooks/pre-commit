#!/bin/sh
# Refuses a commit that leaves test/conformance.tex stale.
#
# The table is generated by test/conformance.sh and kept in the repository,
# because veraPDF is not available on CI. That only works when it is regenerated
# whenever something that can change the verdicts changes, which is what this
# hook is for. Install it with `make install-hooks'.
#
# It only compares a hash of the sources against the one in the table: no Docker,
# no LaTeX, no rebuild. Regenerating is the expensive part, and that is left to
# you, deliberately -- a hook that takes minutes is a hook people disable.
set -e

changed=$(git diff --cached --name-only |
          grep -E '^(src/.*\.(dtx|def|ins)|test/(example|md-example|conformance\.sh))' || true)
[ -n "$changed" ] || exit 0

if make conformance-stale >/dev/null 2>&1; then
    exit 0
fi

echo "pre-commit: the package or the examples changed since test/conformance.tex" >&2
echo "pre-commit: was made. Run 'make conformance' (needs Docker, takes a few" >&2
echo "pre-commit: minutes) and stage the result, or commit with --no-verify when" >&2
echo "pre-commit: the change cannot affect the PDF verdicts." >&2
exit 1
