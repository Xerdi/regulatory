\newif\ifregulatory@markdown
\newif\ifregulatory@bibtogls
\newif\ifregulatory@legacy
\newif\ifregulatory@alldefs
\newboolean{regulatory@nameinlink}
\pgfkeys{
    /regulatory/.is family,
