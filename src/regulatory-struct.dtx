% \subsubsection{The bundle}
%
% The \package{regulatory} package itself is nothing more than a wrapper around the modules that are
% always loaded. \package{regulatory-sign} is among them: it defines two commands and emits nothing until
% one of them is used, and a document that needs a signature field is exactly the kind this bundle is for. Every option is handed over to \package{regulatory-struct}, which administers the options for the
% whole bundle. Both other modules request their prerequisites themselves, so the order below merely
% documents the dependency chain.
% \iffalse
%<*wrapper>
% \fi
%    \begin{macrocode}
\DeclareOption*{\PassOptionsToPackage{\CurrentOption}{regulatory-struct}}
\ProcessOptions\relax
\RequirePackage{regulatory-struct}
\RequirePackage{regulatory-defs}
\RequirePackage{regulatory-ref}
\RequirePackage{regulatory-attachments}
\RequirePackage{regulatory-sign}
\RequirePackage{regulatory-sources}
%    \end{macrocode}
% \iffalse
%</wrapper>
% \fi
%
% \subsubsection{\translation{Package options}{Pakketopties}}
%
% Everything from here on belongs to \package{regulatory-struct}. The options are handled with
% \package{pgfopts}, so all of them are stored in the \texttt{/regulatory} key family.
% \iffalse
%<*package>
% \fi
%    \begin{macrocode}
\RequirePackage{pgfopts}
\RequirePackage{xifthen}
\RequirePackage{keyval}
\RequirePackage{xspace}
%    \end{macrocode}
%
% \begin{macro}{\ifregulatory@markdown}
% \begin{macro}{\ifregulatory@bibtogls}
% \begin{macro}{\ifregulatory@legacy}
% \begin{macro}{\ifregulatory@alldefs}
% \begin{macro}{\ifregulatory@nameinlink}
% Each option is stored in a switch. The switches are shared by all three modules, which is the reason for
% keeping them in this base module. The \texttt{nameinlink} switch is declared with \cmd{\newboolean},
% because it is queried with \cmd{\ifthenelse} in \package{regulatory-ref} as well.
